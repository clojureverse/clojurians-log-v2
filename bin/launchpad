#!/usr/bin/env bb

(require
 '[lambdaisland.launchpad :as launchpad])

(launchpad/main
 {:namespace-maps false
  :middleware []
  :eval-forms []
  :pre-steps
  [(launchpad/run-process {:cmd '[npm install]})
   (launchpad/run-process {:cmd '[npm run dev]
                           :background? true})
   (launchpad/run-process {:cmd '[docker compose up -d --no-recreate]})]})
